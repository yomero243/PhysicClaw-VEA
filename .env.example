# ────────────────────────────────────────────────────────────────
# PhysicClaw-VEA — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Find these in your Supabase project dashboard:
#   Settings → API → Project URL & Project API Keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── LLM (your own key, local only) ────────────────────────────────
# Your API key goes HERE, in your personal .env, and nowhere else. The local
# Vite server (`npm run dev` / `npm run preview`) adds it to requests it
# forwards to LLM_API_URL. It is never sent to the browser, never entered in
# the UI, and never stored in Supabase or anywhere else.
#
# NEVER prefix it with VITE_ — every VITE_* value is shipped to the browser
# (npm run build refuses to build if it finds one that looks like a secret).
#
# Any OpenAI-compatible base URL. Leave empty to use a local OpenClaw gateway
# on OPENCLAW_LOCAL_PORT.
LLM_API_URL=
LLM_API_KEY=

# Model identifier forwarded in the chat completions request body.
VITE_OPENCLAW_MODEL=google/gemini-2.5-flash

# ── Dev Server ────────────────────────────────────────────────────
# Port for the Vite dev server (defaults to 5173).
VITE_PORT=5173

# Port of a local OpenClaw gateway, used when LLM_API_URL is empty.
OPENCLAW_LOCAL_PORT=18789

# Secret token required to POST commands to the /api/control endpoint.
# Any strong random string works (e.g. openssl rand -hex 32).
# If not set, the dev server generates a random token and logs it to stdout.
CONTROL_API_TOKEN=your-control-api-token-here

# ── Optional Tuning ───────────────────────────────────────────────
# How often (ms) the OpenClaw control hook polls openclaw-control.json.
# Defaults to 2000 ms if not set.
VITE_CONTROL_POLL_MS=2000
