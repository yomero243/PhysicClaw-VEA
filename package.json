{
  "name": "physicclaw-vea",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run verify-env && npm run sync-skill",
    "sync-skill": "node -e \"require('fs').copyFileSync('docs/agents/SKILL.md','public/SKILL.md')\"",
    "verify-env": "node ./scripts/verify-env.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run verify-env && npm run typecheck && npm test && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "supabase": "^2.98.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.3",
    "@types/three": "^0.182.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.182.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
